{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-b-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "PROJECT_ID": "project-b", "SERVICE_NAME": "project-b-staging" },
  "assets": {
    "directory": ".assets/project-b-staging",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "project-b-staging-db",
    "database_id": "d446407c-6c4b-4746-b0fb-7368d850986c",
    "migrations_dir": "migrations"
  }]
}
