{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinecore-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "PROJECT_ID": "dineCore", "SERVICE_NAME": "dinecore-staging" },
  "assets": {
    "directory": ".assets/dinecore-staging",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dinecore-staging-db",
    "database_id": "10230112-5e9d-4ed7-ad17-d836896e64b1",
    "migrations_dir": "migrations"
  }]
}
